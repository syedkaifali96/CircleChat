{
  "name": "circlechat",
  "private": true,
  "version": "0.1.0",
  "description": "CircleChat — your little private world. Monorepo: Expo mobile app + Fastify/Socket.IO server + shared TypeScript package.",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "npm run dev --workspace @circlechat/server",
    "dev:mobile": "npm run dev --workspace @circlechat/mobile",
    "dev": "npm run dev:server",
    "minio": "node scripts/minio.mjs",
    "minio:stop": "node scripts/minio.mjs stop",
    "device": "node scripts/device.mjs",
    "typecheck": "npm run build --workspace @circlechat/shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @circlechat/server",
    "db:migrate": "npm run db:migrate --workspace @circlechat/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "eslint": "^9.27.0",
    "typescript-eslint": "^8.32.1"
  }
}
