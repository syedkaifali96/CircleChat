# CircleChat environment template — PLACEHOLDERS ONLY.
# Copy to .env for local development and fill in locally; never commit real values.
# Variable names follow docs/DEPLOYMENT.md §3. Empty values are intentional.

# --- Server ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database (M1 wiring; no credentials exist in this repository) ---
DATABASE_URL=

# --- Sessions / auth (M2 placeholders — see docs/SECURITY.md; do not invent values) ---
SESSION_TTL_DAYS=30

# --- Media storage (M7 — Cloudflare R2 private bucket, or any S3-compatible endpoint) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PRESIGN_TTL_SECONDS=60
# Optional S3 endpoint override — set to the local MinIO endpoint for dev
# (http://127.0.0.1:9000, path-style signing); unset means real Cloudflare R2.
# R2_ENDPOINT=

# --- Push notifications (M8 — server to Expo Push; empty runs the no-op gateway) ---
EXPO_ACCESS_TOKEN=

# --- Monitoring (optional) ---
# SENTRY_DSN=
