{
  "name": "@circlechat/server",
  "version": "0.1.0",
  "private": true,
  "description": "CircleChat API + Socket.IO server (Fastify, TypeScript).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@circlechat/shared": "*",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.3.3",
    "socket.io": "^4.8.1",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vitest": "^3.1.4"
  }
}
