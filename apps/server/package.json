{
  "name": "@circlechat/server",
  "version": "0.1.0",
  "private": true,
  "description": "CircleChat API + Socket.IO server (Fastify, TypeScript).",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/s3-presigned-post": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@circlechat/shared": "*",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.0",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.3.3",
    "pg": "^8.23.0",
    "socket.io": "^4.8.1",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "file-type": "^16.5.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vitest": "^3.1.4"
  }
}
