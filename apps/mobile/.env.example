# CircleChat mobile — Expo app environment template (PLACEHOLDERS ONLY).
# Copy to .env for local development; never commit real values.
# Expo inlines EXPO_PUBLIC_* variables into the JS bundle at build time —
# anything prefixed EXPO_PUBLIC_ is NOT a secret (docs/DEPLOYMENT.md §3).

# Per-build server base URL (docs/DEPLOYMENT.md §3).
EXPO_PUBLIC_API_URL=http://localhost:3000

# GIPHY app key (M7.1a — GIF search runs client-side per GIPHY API ToS,
# which prohibits proxying; the key is public by GIPHY's own design).
# Get a beta key at developers.giphy.com. A production-tier key requires
# GIPHY's app review once "Powered By GIPHY" attribution is live.
EXPO_PUBLIC_GIPHY_API_KEY=
