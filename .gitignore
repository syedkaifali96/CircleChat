npm-debug.log*
.DS_Store
Thumbs.db

# IDE
.idea/
*.iml

# Ephemeral embedded-PostgreSQL data dirs from integration test runs
circlechat-pg-*/

# Freebuff coding-tool workspace metadata (not project code)
.freebuff/

